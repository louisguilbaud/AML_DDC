<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Suivi Navire Segmenté - SAS VA</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { 
            margin: 0; 
            padding: 0; 
            font-family: 'Inter', sans-serif; 
            background: #0b0f19; /* Fond encore plus profond */
        }
        
        #map { 
            height: 100vh; 
            width: 100vw; 
            background: #0b0f19; 
        }

        /* --- Amélioration du contraste de la carte via CSS (Effet premium) --- */
        .leaflet-tile-container {
            /* Augmente légèrement le contraste et réduit la luminosité pour faire ressortir le sillage fluo */
            filter: brightness(0.85) contrast(1.1) saturate(0.9);
        }

        /* --- Popups Premium Style --- */
        .leaflet-popup-content-wrapper {
            background: rgba(15, 23, 42, 0.9) !important; 
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.2); /* Légère lueur bleue sur la bordure */
            border-radius: 14px !important;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.7) !important;
            color: #f8fafc !important;
            padding: 6px;
        }

        .leaflet-popup-tip {
            background: rgba(15, 23, 42, 0.9) !important;
            border: 1px solid rgba(56, 189, 248, 0.2);
        }

        .leaflet-popup-close-button {
            color: #64748b !important;
            padding: 10px 10px 0 0 !important;
        }

        .info-box { 
            font-size: 13px; 
            min-width: 250px; 
            line-height: 1.6;
        }
        
        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08); 
            margin-bottom: 12px; 
            padding-bottom: 8px; 
        }

        .header-title { 
            font-weight: 700; 
            color: #38bdf8; 
            text-transform: uppercase; 
            letter-spacing: 0.7px;
            font-size: 13px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(74, 222, 128, 0.15);
            color: #4ade80;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            background-color: #4ade80;
            border-radius: 50%;
            margin-right: 5px;
            display: inline-block;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .info-label {
            color: #64748b;
            font-weight: 500;
        }

        .info-value {
            color: #e2e8f0;
            font-weight: 600;
        }

        .info-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            margin-top: 10px;
            padding-top: 8px;
            color: #475569;
            font-size: 11px;
            text-align: center;
            font-family: monospace;
        }

        /* --- Animation Pulse Icône --- */
        @keyframes pulse {
            0% { filter: drop-shadow(0 0 2px rgba(74, 222, 128, 0.7)); }
            50% { filter: drop-shadow(0 0 12px rgba(74, 222, 128, 0.9)); }
            100% { filter: drop-shadow(0 0 2px rgba(74, 222, 128, 0.7)); }
        }
        .vessel-pulse {
            animation: pulse 2.5s infinite ease-in-out;
        }
    </style>
</head>
<body>

    <div id="map"></div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet-rotatedmarker@0.2.0/leaflet.rotatedMarker.min.js"></script>

    <script>
        // 1. Initialisation de la carte avec options de propreté visuelle (pas de bounce, pas de répétition sauvage)
        const map = L.map('map', { 
            minZoom: 2,
            maxZoom: 18,
            bounceAtZoomLimits: false
        }).setView([0, 0], 2);
        
        // Utilisation de la version 'nosabels' + injection des frontières/noms de manière plus discrète au besoin.
        // Ici, 'dark_all' reste la plus équilibrée, mais optimisée avec l'option noWrap et les filtres CSS plus haut.
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://carto.com/">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);

        let pathLayer = L.featureGroup().addTo(map);

        function onMessage(event) {
            if (event.data && event.data.data) {
                renderDataTrail(event.data.data);
            }
        }

        function renderDataTrail(rows) {
            pathLayer.clearLayers();
            if (rows.length === 0) return;

            let latestIndex = 0;
            let maxTimestamp = -1;

            rows.forEach((row, index) => {
                const ts = new Date(row[8]).getTime();
                if (ts > maxTimestamp) {
                    maxTimestamp = ts;
                    latestIndex = index;
                }
            });

            const allCoordinates = [];
            let currentPath = [];
            const threshold = 10; 

            rows.forEach((row, index) => {
                const lat = row[0];
                const lng = row[1];
                const heading = row[2];

                if (lat == null || lng == null) return;

                if (currentPath.length > 0) {
                    const lastPoint = currentPath[currentPath.length - 1];
                    const distance = Math.sqrt(Math.pow(lat - lastPoint[0], 2) + Math.pow(lng - lastPoint[1], 2));
                    
                    if (distance > threshold) {
                        allCoordinates.push(currentPath);
                        currentPath = [];
                    }
                }
                
                currentPath.push([lat, lng]);

                if (index === latestIndex) {
                    const shipIcon = L.divIcon({
                        html: `<svg class="vessel-pulse" viewBox="0 0 24 24" width="42" height="42" fill="#4ade80">
                                <path d="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"/></svg>`,
                        className: '',
                        iconSize: [42, 42],
                        iconAnchor: [21, 21]
                    });

                    let dateFormatee = row[8];
                    try {
                        const d = new Date(row[8]);
                        if(!isNaN(d)) {
                            dateFormatee = d.toLocaleString('fr-FR', { timeZone: 'UTC' }) + ' UTC';
                        }
                    } catch(e) {}

                    const marker = L.marker([lat, lng], { 
                        icon: shipIcon,
                        rotationAngle: heading 
                    }).addTo(pathLayer);

                    marker.bindPopup(`
                        <div class="info-box">
                            <div class="header-container">
                                <div class="header-title">${row[5] || 'NAVIRE'}</div>
                                <div class="status-badge"><span class="status-dot"></span>LIVE</div>
                            </div>
                            <div class="info-row"><span class="info-label">Date</span><span class="info-value">${dateFormatee}</span></div>
                            <div class="info-row"><span class="info-label">Vitesse</span><span class="info-value">${row[3]?.toFixed(1)} kts</span></div>
                            <div class="info-row"><span class="info-label">Cap</span><span class="info-value">${heading}°</span></div>
                            <div class="info-row"><span class="info-label">Tonnage</span><span class="info-value">${row[6] ? row[6].toLocaleString() + ' DWT' : 'N/A'}</span></div>
                            <div class="info-footer">POS: ${lat.toFixed(5)}, ${lng.toFixed(5)}</div>
                        </div>
                    `).openPopup();
                }
            });
            
            allCoordinates.push(currentPath);

            // Dessin du sillage ultra-propre (Style "Glow / Néon")
            allCoordinates.forEach(path => {
                if (path.length > 1) {
                    // Halo lumineux arrière-plan
                    L.polyline(path, {
                        color: '#0ea5e9',
                        weight: 6,
                        opacity: 0.2,
                        lineJoin: 'round'
                    }).addTo(pathLayer);

                    // Ligne principale nette
                    L.polyline(path, {
                        color: '#38bdf8',
                        weight: 2,
                        opacity: 0.9,
                        lineJoin: 'round',
                        dashArray: '8, 6'
                    }).addTo(pathLayer);
                }
            });

            if (pathLayer.getBounds().isValid()) {
                map.fitBounds(pathLayer.getBounds(), { padding: [60, 60] });
            }
        }

        window.addEventListener('message', onMessage, false);
    </script>
</body>
</html>
